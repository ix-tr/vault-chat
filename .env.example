CHAT_HOST=chat.localhost
ADMIN_HOST=admin.localhost
CHAT_ORIGIN=https://chat.localhost:8443
ADMIN_ORIGIN=https://admin.localhost:8443
LAN_IP=127.0.0.1
TURN_EXTERNAL_IP=127.0.0.1
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
# Local orchestration generates TURN/LiveKit secrets in ignored infra/runtime.
# No service-role key belongs in NEXT_PUBLIC_* variables.
# Server authentication stays disabled until the complete activation UI and
# encrypted device Worker are integrated and verified. Never use a management
# access token as a project API key. Set these only on the chat server.
VAULT_AUTH_ENABLED=false
VAULT_CHAT_ORIGIN=https://chat.localhost:8443
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Alternatively use SUPABASE_SECRET_KEY for a new server secret API key.
