{
  "name": "vault-chat",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:all": "node scripts/local.mjs start",
    "dev:stop": "node scripts/local.mjs stop",
    "dev:reset": "node scripts/local.mjs reset",
    "certs": "node scripts/local.mjs certs",
    "build": "pnpm build:auth-assets && pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.tooling.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test:infra && pnpm test",
    "prepare": "node scripts/hooks.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test:infra": "node --test tests/infra/*.test.mjs",
    "test:hosted": "playwright test --config playwright.hosted.config.ts",
    "verify:hosted": "node scripts/verify-hosted.mjs",
    "build:crypto-spike": "node scripts/build-crypto-spike.mjs",
    "test:crypto-spike": "playwright test --config playwright.crypto.config.ts",
    "build:unlock-spike": "node scripts/build-unlock-spike.mjs",
    "test:db": "node scripts/test-db.mjs",
    "test:auth": "node --test tests/auth/chat-auth.test.mjs",
    "auth:bootstrap": "node scripts/auth-bootstrap.mjs",
    "build:auth-assets": "node scripts/build-auth-assets.mjs",
    "test:auth-browser": "playwright test --config playwright.auth.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.57.0",
    "esbuild": "0.28.2",
    "eslint": "^10.12.0",
    "libsodium-wrappers-sumo": "0.8.4",
    "supabase": "^2.65.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "@supabase/supabase-js": "2.117.2"
  }
}
